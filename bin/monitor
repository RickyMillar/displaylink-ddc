#!/usr/bin/env python3
"""Control an external monitor over DDC/CI through a DisplayLink dock.

Usage:
  monitor                       show brightness, contrast, RGB gain
  monitor brightness [VALUE]    VALUE: 50, +10 or -10
  monitor contrast|red|green|blue [VALUE]
  monitor preset [6500k|9300k|user1|user2]
  monitor mode [standard|mixed|movie|games]
  monitor input [dp1|dp2|hdmi]
  monitor power [on|standby|off]
  monitor caps                  show the capabilities string of the monitor

The named values for preset, mode and input come from one Samsung monitor.
Run "monitor caps" to see the values your monitor supports. You can also
give a raw value, for example "monitor input 0x11".
"""
import fcntl
import glob
import os
import sys
import time
import argparse
from re import split as re_split

I2C_SLAVE = 0x0703
DDC_ADDR = 0x37
BUS_NAME = "DisplayLink I2C Adapter"

FEATURES = {
    "brightness": 0x10, "contrast": 0x12,
    "red": 0x16, "green": 0x18, "blue": 0x1A,
    "preset": 0x14, "mode": 0xDC, "input": 0x60, "power": 0xD6,
}

# Named values, from the capabilities string of this Samsung monitor.
NAMED = {
    "preset": {"6500k": 0x05, "9300k": 0x08, "user1": 0x0B, "user2": 0x0C},
    "mode": {"standard": 0x00, "mixed": 0x02, "movie": 0x03, "games": 0x05},
    "input": {"dp1": 0x0F, "dp2": 0x10, "hdmi": 0x12},
    "power": {"on": 0x01, "standby": 0x04, "off": 0x05},
}

def find_bus(do_all=False):
    buses = []
    for path in glob.glob("/sys/bus/i2c/devices/i2c-*/name"):
        with open(path) as f:
            if f.read().strip() == BUS_NAME:
                buses.append("/dev/" + path.split("/")[-2])
    if len(buses) == 0:
        sys.exit(f"monitor: no '{BUS_NAME}' bus found. Is the dock connected?")
    elif do_all:
        return buses
    else:
        return buses[0]

def checksum(first, data):
    chk = first
    for b in data:
        chk ^= b
    return chk


class Monitor:
    def __init__(self, bus):
        self.fd = os.open(bus, os.O_RDWR)
        fcntl.ioctl(self.fd, I2C_SLAVE, DDC_ADDR)

    def _send(self, payload):
        msg = [0x51, 0x80 | len(payload)] + payload
        os.write(self.fd, bytes(msg + [checksum(0x6E, msg)]))

    def get(self, code, retries=3):
        for _ in range(retries):
            self._send([0x01, code])
            time.sleep(0.05)
            try:
                r = os.read(self.fd, 11)
            except OSError:
                r = b""
            if (len(r) == 11 and r[2] == 0x02 and r[3] == 0x00 and r[4] == code
                    and checksum(0x50, r[:10]) == r[10]):
                return (r[8] << 8) | r[9], (r[6] << 8) | r[7]
            time.sleep(0.05)
        sys.exit(f"monitor: no valid reply for feature 0x{code:02X}")

    def capabilities(self):
        out, offset, fails = b"", 0, 0
        while fails < 5:
            self._send([0xF3, offset >> 8, offset & 0xFF])
            time.sleep(0.06)
            try:
                r = os.read(self.fd, 38)
            except OSError:
                r = b""
            n = (r[1] & 0x7F) - 3 if len(r) > 5 else -1
            if n < 0 or r[2] != 0xE3 or ((r[3] << 8) | r[4]) != offset:
                fails += 1
                time.sleep(0.1)
                continue
            if n == 0:
                return out.decode(errors="replace")
            out += r[5:5 + n]
            offset += n
        sys.exit("monitor: could not read the capabilities string")

    def set(self, code, value):
        self._send([0x03, code, value >> 8, value & 0xFF])
        time.sleep(0.05)


def resolve_value(arg, current, maximum):
    """Turn a user argument ("50", "+10", "-10") into a new absolute value."""
    try:
        n = int(arg)
    except ValueError:
        sys.exit(f"monitor: bad value '{arg}'. Use 50, +10 or -10")
    if arg[0] in "+-":
        n += current
    return max(0, min(maximum, n))


# Get dict linking i2c device & model:
# {"model":"/dev/i2c-n"}
def list_monitors(do_print=False):
    buses = find_bus(do_all=True)
    mons = {}
    for bus in buses:
        mon = Monitor(bus)
        caps = mon.capabilities()
        caps = re_split(r"\(|\)", caps)
        try:
            model = caps[caps.index("model") + 1]
            mons[model] = bus
        except ValueError:
            model = "No model found :("
        if do_print:
            print(f"{bus}\n{model}\n")
    return mons


def parser():
    common_parser = argparse.ArgumentParser(add_help=False)
    common_parser.add_argument(
            '-m', '--models',
            default=[],
            nargs="+",
            help='''
            Model number of targeted monitor(s), see list.
            Default is 1st monitor in /dev/i2c-*, alphabetical order.''')
    common_parser.add_argument(
            '-d', '--devices',
            default=[],
            type=int,
            nargs="+",
            help='''
            i2c index of targeted monitor(s) (/dev/i2c-d), see list.
            Default is 1st monitor in /dev/i2c-*, alphabetical order.''')

    parser = argparse.ArgumentParser(
            prog='monitors.py',
            description='''
            DDC/CI over displaylink.
            No arguments prints the brightness, contrast & RGB gain''',
            epilog='''
The named values for preset, mode and input come from one Samsung monitor.
Run "monitor caps" to see the values your monitor supports. You can also
give a raw value, for example "monitor input 0x11".
See: https://github.com/RickyMillar/displaylink-ddc
            '''
            )
    subparsers = parser.add_subparsers(dest="command")

    list_parser = subparsers.add_parser(
            "list",
            help="List i2c device and model for each monitor, for -m and -d")

    caps_parser = subparsers.add_parser(
            "caps", 
            help="List the capabilities of the monitor",
            parents=[common_parser])

    # NAMED & FEATURES as args.
    command_parsers = {}

    values = ("brightness", "contrast", "red", "blue", "green")
    for feature in FEATURES.keys():
        command_parsers[feature] = subparsers.add_parser(
                feature, parents=[common_parser])
        if feature in values:
            help_str='''Absolute or relative, eg: 50, +10 or -10'''
        else:
            help_str = ''
        command_parsers[feature].add_argument(
                "value", nargs="?", default=None, help=help_str, type=str)

    for name, val in NAMED.items():
        for action in command_parsers[name]._actions:
            # Give raw value to input.
            if action.dest == "value" and name != "input":
                action.choices = list(val.keys())
            elif action.dest == "value" and name == "input":
                action.help = f'''{', '.join(NAMED[name].keys())} or raw value
                (eg: input 0x11)'''

    args = parser.parse_args()
    return args


def command(bus, name=None, value=None):
    mon = Monitor(bus)

    if name == None:
        for name in ("brightness", "contrast", "red", "green", "blue"):
            cur, mx = mon.get(FEATURES[name])
            print(f"{name:<11} {cur}/{mx}")
        return

    if name == "caps":
        print(mon.capabilities())
        return

    code = FEATURES[name]

    if name in NAMED:
        names = NAMED[name]
        if value == None:  # Command w/o value, print help.
            cur, _ = mon.get(code)
            label = next((k for k, v in names.items() if v == cur), "unknown")
            print(f"{name} 0x{cur:02X} ({label})  options: {', '.join(names)}")
        else:
            arg = value.lower()
            mon.set(code, names[arg] if arg in names else int(arg, 0))
        return

    cur, mx = mon.get(code)
    if value == None:
        print(f"{name} {cur}/{mx}")
        return
    new = resolve_value(value, cur, mx)
    mon.set(code, new)
    print(f"{name} {cur} -> {new}")


def main():
    args = parser()

    if args.command == "list":
        list_monitors(do_print=True)
        return

    buses = [f"/dev/i2c-{idx}" for idx in args.devices]
    if args.models != []:
        monitors = list_monitors()
        for model in args.models:
            buses.append(monitors[model])
    buses = list(set(buses))  # One call paer monitor.
    if len(buses) == 0:
        buses = [find_bus(do_all=False)]

    for bus in buses:
        try:
            args.value
        except AttributeError:
            args.value = None
        command(bus, args.command, args.value)


if __name__ == "__main__":
    main()
