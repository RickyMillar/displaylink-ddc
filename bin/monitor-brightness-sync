#!/usr/bin/env python3
"""Copy the laptop screen brightness (GNOME) to the external monitor over DDC/CI."""
import os
import re
import selectors
import subprocess

MONITOR = os.path.join(os.path.dirname(os.path.realpath(__file__)), "monitor")
SETTLE = 0.15  # seconds to wait for more key presses before one DDC write

gdbus = subprocess.Popen(
    ["gdbus", "monitor", "--session",
     "--dest", "org.gnome.SettingsDaemon.Power",
     "--object-path", "/org/gnome/SettingsDaemon/Power"],
    stdout=subprocess.PIPE, text=True, bufsize=1)

sel = selectors.DefaultSelector()
sel.register(gdbus.stdout, selectors.EVENT_READ)
pattern = re.compile(r"'Brightness': <(\d+)>")
pending = None

while True:
    events = sel.select(timeout=SETTLE if pending is not None else None)
    if not events:
        subprocess.run([MONITOR, "brightness", str(pending)],
                       stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
        pending = None
        continue
    line = gdbus.stdout.readline()
    if not line:
        raise SystemExit("gdbus monitor exited")
    m = pattern.search(line)
    if m:
        pending = int(m.group(1))
